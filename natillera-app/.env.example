# -----------------------------------------------------------------
# Fuente de datos:
#   express  → usa el backend Node local (natillera-backend, http://localhost:4000)
#   supabase → lee directamente del proyecto Supabase
# -----------------------------------------------------------------
VITE_NAT_DATA_SOURCE=express

# Solo si VITE_NAT_DATA_SOURCE=express
VITE_NAT_API=http://localhost:4000

# Solo si VITE_NAT_DATA_SOURCE=supabase
# ⚠️ Solo pega aquí la ANON key (públicable). NUNCA la service_role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx
